  "stepEquationTakenAway": "{whole}-இலிருந்து காலியைக் கழித்தால் {part} மீதம் இருக்கும். காலியைக் கண்டுபிடிக்க, {whole}-இலிருந்து {part}-ஐக் கழி.",
  "stepEquationUndoSubtract": "காலியிலிருந்து {part}-ஐக் கழித்தால் {rest} மீதம் இருக்கும். கழித்ததைச் செயல்தவிர்க்க, {rest}-உடன் {part}-ஐ மீண்டும் கூட்டு.",
  "stepEquationUndoMultiply": "{factor}-ஐயும் காலியையும் பெருக்கினால் {product} வரும். பெருக்கியதைச் செயல்தவிர்க்க, {product}-ஐ {factor}-ஆல் வகு.",
  "stepEquationDividedBy": "{whole}-ஐ காலியால் வகுத்தால் {quotient} வரும். காலியைக் கண்டுபிடிக்க, {whole}-ஐ {quotient}-ஆல் வகு.",
  "stepEquationUndoDivide": "காலியை {divisor}-ஆல் வகுத்தால் {quotient} வரும். வகுத்ததைச் செயல்தவிர்க்க, {quotient}-ஐ {divisor}-ஆல் பெருக்கு.",
  "stepEquationBlankIs": "{calculation}, ஆக காலி {answer}. சரிபார்: {check}",
  "stepEquationMeans": "{shorthand} என்றால் {meaning}.",
  "stepEquationBelowZero": "இந்த முறை பதில் பூஜ்ஜியத்தை விடக் குறைவு. அதற்கு முன்னால் கழித்தல் குறி (−) போட்டு எழுதுவோம்.",
  "stepEquationSubtractBoth": "+ {number}-ஐச் செயல்தவிர்க்க, இரு பக்கங்களிலிருந்தும் {number}-ஐக் கழி.",
  "stepEquationAddBoth": "− {number}-ஐச் செயல்தவிர்க்க, இரு பக்கங்களிலும் {number}-ஐக் கூட்டு.",
  "stepEquationDivideBoth": "× {number}-ஐச் செயல்தவிர்க்க, இரு பக்கங்களையும் {number}-ஆல் வகு.",
  "stepEquationMultiplyBoth": "÷ {number}-ஐச் செயல்தவிர்க்க, இரு பக்கங்களையும் {number}-ஆல் பெருக்கு.",
  "stepEquationSoNow": "{calculation}, ஆக {equation}.",
  "stepEquationLetterIs": "{calculation}, ஆக n = {answer}. சரிபார்: {check}",
  "stepEquationWhichRoot": "√{square} என்றால்: எந்த எண்ணை அதே எண்ணால் பெருக்கினால் {square} வரும்?",
  "stepEquationWhichPositiveRoot": "n² என்றால் n × n. இங்கே n நேர்மறை எண். பூஜ்ஜியத்தை விடப் பெரிய எந்த எண்ணை அதே எண்ணால் பெருக்கினால் {square} வரும்?",
  "hintAskBlank": "காலிப் பெட்டியில் வர வேண்டிய எண் எது என்று கண்டுபிடிக்கணும்.",
  "hintAskLetter": "n எந்த எண்ணைக் குறிக்குது என்று கண்டுபிடிக்கணும்.",
  "hintIdeaAddAndTakeAway": "கூட்டலும் கழித்தலும் ஒன்றையொன்று சரிசெய்யும். கழித்தலைக் கூட்டல் நீக்கும்.",
  "hintIdeaSwapTakeAway": "கழித்தலில், எடுத்த பகுதியும் மீதி இருக்கும் பகுதியும் இடம் மாறிக்கொள்ளலாம்.",
  "hintIdeaMultiplyAndDivide": "பெருக்கலும் வகுத்தலும் ஒன்றையொன்று சரிசெய்யும்.",
  "hintIdeaSwapDivide": "வகுத்தலில், வகுக்கும் எண்ணும் விடையும் இடம் மாறிக்கொள்ளலாம்.",
  "hintIdeaSquared": "ஒரு எண்ணுக்குப் பின் சிறிய ² வந்தால், அந்த எண்ணை அதே எண்ணால் பெருக்கணும். அதை வர்க்கம் என்போம்.",
  "hintIdeaSquareRoot": "வர்க்கமூலக் குறி √ வர்க்கம் எடுப்பதை நீக்கும். வர்க்கம் என்றால் ஒரு எண்ணை அதே எண்ணால் பெருக்குவது.",
  "hintIdeaBalance": "= குறியின் இரு பக்கமும் சமம், தராசு போல. ஒரு படி செய்தால் இரு பக்கமும் அதையே செய்.",
  "countTens": "{count, plural, =1{1 பத்து} other{{count} பத்துகள்}}",
  "countHundreds": "{count, plural, =1{1 நூறு} other{{count} நூறுகள்}}",
  "countThousands": "{count, plural, =1{1 ஆயிரம்} other{{count} ஆயிரங்கள்}}",
  "countTenThousands": "{count, plural, =1{1 பத்தாயிரம்} other{{count} பத்தாயிரங்கள்}}",
  "placeTens": "பத்துகள்",
  "placeHundreds": "நூறுகள்",
  "placeThousands": "ஆயிரங்கள்",
  "placeTenThousands": "பத்தாயிரங்கள்",
  "privacyTitle": "தனியுரிமைக் கொள்கை",
  "privacyIntro": "கணக்குப் பயிற்சி என்பது குழந்தைகளுக்கான இலவசக் கணக்குப் பயிற்சி ஆப், விளம்பரங்கள் இல்லை. இந்தக் கொள்கை Android, iOS ஆப்களுக்கும் இணையப் பதிப்புக்கும் பொருந்தும். கடைசியாகப் புதுப்பிக்கப்பட்டது: 21 நவம்பர் 2026.",
  "privacyCollectsHeading": "ஆப் என்ன சேகரிக்கிறது",
  "privacyCollects": "தனிப்பட்ட தகவல் எதுவும் இல்லை. கணக்குகள் இல்லை, பகுப்பாய்வு இல்லை, விளம்பரம் இல்லை, கண்காணிப்பு இல்லை. ஆப் ஒரே ஒரு வகைக் கோரிக்கையை மட்டும் அனுப்பும்: ஒரு பெரியவர் தாமாக அனுப்பத் தேர்ந்தெடுக்கும் அறிக்கை (கீழே சிக்கலைத் தெரிவி பார்). வேறு எந்தக் கோரிக்கையும் அனுப்பாது.",
  "privacyStoresHeading": "ஆப் உன் சாதனத்தில் என்ன சேமிக்கிறது",
  "privacyStores": "அமர்வுகளுக்கு இடையே உன் முன்னேற்றம் இருக்க, ஆப் உன் பதில்கள், தவறு என்று குறித்த கேள்விகள், ஒவ்வொரு வகைப் பயிற்சியிலும் உன் நிலை, உன் அமைப்புகள் (ஒலி, அதிர்வு போன்றவை) ஆகியவற்றை உன் சொந்தச் சாதனத்திலேயே சேமிக்கும்: Android, iOS-இல் ஆ�்பின் தனிச் சேமிப்பகத்தில், இணையத்தில் உன் பிரவுசரின் உள்ளூர் சேமிப்பகத்தில். இந்தத் தகவல் சாதனத்தை விட்டு வெளியே போகாது. ஆப்பை நீக்கினால், அல்லது பிரவுசரில் தளத்தின் தகவலை அழித்தால், அது அழியும்.",
  "privacyOffline": "ஆப் இணையம் இல்லாமலும் வேலை செய்யும். Android ஆப் இணைய அனுமதி கேட்பது, ஒரு பெரியவர் தாமாக அனுப்பத் தேர்ந்தெடுக்கும் அறிக்கையை அனுப்ப மட்டுமே.",
  "privacyWebHeading": "வலைப் பதிப்பு",
  "privacyWebHost": "வலைப் பதிப்பு Cloudflare Pages மூலம் வழங்கப்படுகிறது. எந்த வலை ஹோஸ்டையும் போல, உன் பிரவுசர் தளத்தை ஏற்றும்போது, அதை வழங்கவும் தவறான பயன்பாட்டிலிருந்து பாதுகாக்கவும் Cloudflare உன் IP முகவரியையும் வழக்கமான கோரிக்கை விவரங்களையும் (பிரவுசர் வகை, கேட்கப்பட்ட பக்கம் போன்றவை) பெறுகிறது. Cloudflare தனியுரிமைக் கொள்கையைப் பார்.",
  "privacyWebFiles": "எழுத்துருக்கள் உட்பட ஆப்புக்குத் தேவையான எல்லாக் கோப்புகளும் ஆப்பின் சொந்தத் தளத்திலிருந்தே வருகின்றன; ஆப் வேறு எந்த இணையதளத்திலிருந்தும் எதையும் ஏற்றுவதில்லை. முதல் முறை வந்த பிறகு, உன் பிரவுசர் ஆப்பின் ஒரு நகலை வைத்துக்கொள்கிறது, அதனால் ஆப் இணையம் இல்லாமலும் தொடங்கும். இந்த நகலில் ஆப்பின் கோப்புகள் மட்டுமே உள்ளன, தனிப்பட்ட தரவு இல்லை.",
  "privacyImpressumHeading": "Impressum பக்கம்",
  "privacyImpressum": "Impressum (வழங்குநர் அடையாளம்) அதே தளத்தில் உள்ள ஒரு தனிப் பக்கம். நீ அமைப்புகளில் Impressum-ஐத் தேர்ந்தெடுக்கும்போது மட்டுமே ஆப் அதை உன் பிரவுசரில் திறக்கும். அந்தப் பக்கம், அந்தப் பக்கம் மட்டுமே, Cloudflare Turnstile-ஐ ஏற்றுகிறது; அது மனிதர்களையும் போட்களையும் வேறுபடுத்த, பார்வையாளரின் IP முகவரியையும் பிரவுசர் சமிக்ஞைகளையும் பெறுகிறது. Cloudflare தனியுரிமைக் கொள்கையைப் பார்.",
  "privacyReportHeading": "சிக்கலைத் தெரிவித்தல்",
  "privacyReport": "அமைப்புகளில் உள்ள சிக்கலைத் தெரிவி என்பது உன் பிரவுசரில் GitHub-இல் புதிய பிரச்சினையைத் திறக்கும், ஆப்பின் பதிப்பும் தளமும் முன்கூட்டியே நிரப்பப்பட்டிருக்கும், நீண்ட விவரம் எழுதலாம். அங்கே ஆப் தானாக எதையும் அனுப்பாது. அந்தப் பிரச்சினையை நீ சமர்ப்பித்தால் அது பொதுவானது, GitHub-இன் சொந்தத் தனியுரிமைக் கொள்கை பொருந்தும்.",
  "privacyReportSend": "ஒரு கேள்வியைத் தவறு என்று குறிக்கலாம்; அந்தக் குறி சாதனத்திலேயே இருக்கும், எதையும் அனுப்பாது. ஒரு பெரியவர் அறிக்கையை அனுப்பு என்பதைத் தேர்ந்தெடுத்து, பட்டியலில் இருந்து ஒரு காரணத்தைத் தேர்ந்தெடுத்து, பெரியவர் சரிபார்ப்பைக் கடந்தால் மட்டுமே அறிக்கை அனுப்பப்படும் (சொற்களில் காட்டப்படும் ஒரு எண்ணைத் தட்டச்சு செய்வது; இது சிறு குழந்தைகளைத் தாமதப்படுத்தும், ஆனால் பூட்டு அல்ல). அமைப்புகளில் உள்ள சிக்கல் அறிக்கையை அனுப்பு என்பதும் அதேபோலவே வேலை செய்யும், சிக்கலின் வகை பட்டியலில் இருந்து தேர்ந்தெடுக்கப்படும். ஒவ்வொரு அறிக்கையும் ஆப்பின் சொந்தத் தளமான math.munich-tech.de-க்கு Cloudflare வழியாக அனுப்பப்படும் ஒரு கோரிக்கை. அதில் கேள்விக் குறியீடு (அல்லது சிக்கலின் வகை), காரணம், ஆப்பின் பதிப்பு, தளம், ஆப்பின் மொழி மட்டுமே இருக்கும்: பெயர் இல்லை, முன்னேற்றம் இல்லை, தட்டச்சு செய்தது எதுவும் இல்லை. அந்தத் தளத்தில் உள்ள ஒரு செயல்பாடு அதை GitHub-இல் பொதுவான பிரச்சினையாக மாற்றும், அதில் தனிப்பட்ட தகவல் எதுவும் இருக்காது. எந்த இணையக் கோரிக்கையையும் போல, அறிக்கை Cloudflare-க்கு உன் IP முகவரியைத் தெரிவிக்கும்; அந்தச் செயல்பாடு அதைச் சேமிக்காது.",
  "privacyChildrenHeading": "குழந்தைகள்",
  "privacyChildren": "இந்த ஆப் குழந்தைகளுக்காக உருவாக்கப்பட்டது, குழந்தைகள் உட்பட யாரிடமிருந்தும் தனிப்பட்ட தகவல் எதையும் சேகரிக்காது. ஒரு பெரியவர் மட்டுமே அறிக்கையை அனுப்ப முடியும், அந்த அறிக்கையில் தனிப்பட்ட தகவல் எதுவும் இருக்காது.",
  "privacyChangesHeading": "மாற்றங்களும் தொடர்பும்",
